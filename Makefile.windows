CC = gcc
CFLAGS = -O2 -Wall -Wextra -Isrc -Iray/include
LDFLAGS = ray/lib/libraylib.a -lopengl32 -lgdi32 -lwinmm

SRC = src/main.c src/snowflake.c
OBJ = $(SRC:.c=.o)
EXEC = snowflake.exe

all: $(EXEC)

$(EXEC): $(OBJ)
	$(CC) $(OBJ) -o $@ $(LDFLAGS)

src/%.o: src/%.c src/snowflake.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f src/*.o $(EXEC)

run: $(EXEC)
	./$(EXEC)

.PHONY: all clean run
