CC = clang
CFLAGS = -O2 -Wall -Wextra -Isrc -I/opt/homebrew/include -I/usr/local/include -Iray/include
LDFLAGS = -L/opt/homebrew/lib -L/usr/local/lib -lraylib -framework OpenGL -framework Cocoa -framework IOKit -framework CoreVideo

SRC = src/main.c src/snowflake.c
OBJ = $(SRC:.c=.o)
EXEC = snowflake

all: $(EXEC)

$(EXEC): $(OBJ)
	$(CC) $(OBJ) -o $@ $(LDFLAGS)

src/%.o: src/%.c src/snowflake.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f src/*.o $(EXEC)

run: $(EXEC)
	./$(EXEC)

.PHONY: all clean run
